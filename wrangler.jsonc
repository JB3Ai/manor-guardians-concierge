{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manor-guardians-concierge",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-18",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "manor_guardians_db",
      "database_name": "manor-guardians-db",
      "database_id": "f28377b1-2eca-4da1-b07f-f2ba6557e6aa",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "manor_guardians_media",
      "bucket_name": "manor-guardians-media"
    }
  ]
}
